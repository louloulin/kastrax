package ai.kastrax.examples.agent

import ai.kastrax.core.agent.Agent
import ai.kastrax.core.agent.AgentGenerateOptions
import ai.kastrax.core.agent.AgentResponse
import ai.kastrax.core.agent.AgentStreamResponse
import ai.kastrax.core.agent.agent
import ai.kastrax.core.agent.autonomy.*
import ai.kastrax.core.llm.*
import ai.kastrax.integrations.deepseek.DeepSeekModel
import ai.kastrax.integrations.deepseek.deepSeek
import kotlinx.coroutines.flow.Flow
import kotlinx.coroutines.flow.collect
import kotlinx.coroutines.runBlocking

/**
 * 创造性Agent示例
 */
fun main() = runBlocking {
    println("KastraX 创造性Agent示例")
    println("-------------------")

    // 使用 DSL 创建创造性Agent
    val creativeAgent = creativeAgent {
        // 设置基础Agent属性
        name("CreativeAssistant")
        instructions("You are a helpful and creative assistant. You excel at generating creative ideas, exploring new concepts, and providing innovative solutions.")
        model(deepSeek {
            model(DeepSeekModel.DEEPSEEK_CHAT)
            // 使用环境变量中的API密钥
            apiKey("sk-85e83081df28490b9ae63188f0cb4f79")
        })

        // 配置自主性
        autonomy {
            mode = AutonomyMode.CREATIVE
            level = AutonomyLevel.HIGH
            creativityLevel = 0.8
            explorationRate = 0.6

            // 启用能力
            enableCapability(AutonomyCapability.SELF_REFLECTION)
            enableCapability(AutonomyCapability.IDEA_GENERATION)
            enableCapability(AutonomyCapability.CREATIVITY)
            enableCapability(AutonomyCapability.EXPLORATION)
            enableCapability(AutonomyCapability.GOAL_SETTING)

            // 添加约束
            addConstraint("生成的内容必须是原创的")
            addConstraint("生成的内容必须是有用的")
            addConstraint("生成的内容必须是适合所有年龄段的")
        }
    }

    // 获取自主性管理器
    val autonomy = creativeAgent.getAutonomy()

    println("\n1. 标准响应生成 (流式模式)")
    println("-------------------")
    println("响应: ")
    // 使用流式响应
    val responseFlow = creativeAgent.generateStream("What is creativity?")
    responseFlow.collect { chunk ->
        // 打印每个流式响应块
        print(chunk.text)
        // 刷新输出，确保实时显示
        System.out.flush()
    }
    println() // 添加换行

    println("\n2. 创意内容生成 (流式模式)")
    println("-------------------")
    println("组合式创意（结合现有概念）:")
    println("内容: ")
    // 使用流式响应生成组合式创意内容
    val combinationalPrompt = "Create a new sport that combines elements of chess and basketball"
    val combinationalFlow = creativeAgent.generateCreativeContentStream(combinationalPrompt, CreativityType.COMBINATIONAL)
    combinationalFlow.collect { chunk ->
        print(chunk.text)
        System.out.flush()
    }
    println()

    println("\n探索式创意（探索现有概念空间）:")
    println("内容: ")
    // 使用流式响应生成探索式创意内容
    val exploratoryPrompt = "Reimagine how education could work in the digital age"
    val exploratoryFlow = creativeAgent.generateCreativeContentStream(exploratoryPrompt, CreativityType.EXPLORATORY)
    exploratoryFlow.collect { chunk ->
        print(chunk.text)
        System.out.flush()
    }
    println()

    println("\n转换式创意（改变概念空间）:")
    println("内容: ")
    // 使用流式响应生成转换式创意内容
    val transformationalPrompt = "Invent a completely new form of art that doesn't exist today"
    val transformationalFlow = creativeAgent.generateCreativeContentStream(transformationalPrompt, CreativityType.TRANSFORMATIONAL)
    transformationalFlow.collect { chunk ->
        print(chunk.text)
        System.out.flush()
    }
    println()

    println("\n3. 自主探索 (流式模式)")
    println("-------------------")
    println("探索主题: 'The future of work'")
    println("探索结果:")

    // 使用流式响应进行自主探索
    val explorationFlow = creativeAgent.exploreAutonomouslyStream("The future of work", 2)

    explorationFlow.collect { chunk ->
        print(chunk.text)
        System.out.flush()
    }
    println()

    println("\n4. 自主目标设定")
    println("-------------------")
    // 设置自主目标
    val goal1 = autonomy.setAutonomousGoal("Generate innovative solutions for climate change", 3)
    val goal2 = autonomy.setAutonomousGoal("Explore new storytelling techniques", 2)
    val goal3 = autonomy.setAutonomousGoal("Learn about emerging technologies", 1)

    // 显示目标
    println("设定的目标:")
    autonomy.getGoals().forEach { goal ->
        println("- ${goal.description} (优先级: ${goal.priority})")
    }

    // 完成一个目标
    autonomy.updateGoalStatus(goal2.id, GoalStatus.COMPLETED)
    println("\n更新后的活跃目标:")
    autonomy.getGoals().forEach { goal ->
        println("- ${goal.description} (优先级: ${goal.priority})")
    }

    println("\n5. 自主行为历史")
    println("-------------------")
    println("Agent的自主行为历史:")
    autonomy.getBehaviorHistory().forEach { behavior ->
        println("- ${behavior.timestamp}: ${behavior.type} - ${behavior.description}")
    }

    println("\n6. 创意内容历史")
    println("-------------------")
    println("Agent的创意内容历史:")
    autonomy.getCreativeHistory().forEach { content ->
        println("- ${content.timestamp}: ${content.type} - ${content.content.take(50)}...")
    }
}


