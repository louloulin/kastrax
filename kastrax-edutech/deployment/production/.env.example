# Kastrax教育科技AI解决方案 - 生产环境配置示例
# 复制此文件为 .env 并填入实际的配置值

# 数据库配置
DB_USERNAME=kastrax_user
DB_PASSWORD=your_secure_database_password_here
POSTGRES_DB=kastrax_edutech

# Redis配置
REDIS_PASSWORD=your_secure_redis_password_here

# 应用安全配置
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
ENCRYPTION_KEY=your_encryption_key_32_characters_here

# 监控配置
GRAFANA_PASSWORD=your_grafana_admin_password_here

# 部署配置
VERSION=latest
ENVIRONMENT=production

# SSL配置 (可选)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/private.key

# 外部服务配置 (可选)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=your_smtp_password_here

# 备份配置
BACKUP_SCHEDULE=0 2 * * *  # 每天凌晨2点备份
BACKUP_RETENTION_DAYS=30

# 性能配置
MAX_HEAP_SIZE=4g
MAX_CONCURRENT_SESSIONS=1000
SESSION_TIMEOUT_MINUTES=30

# 日志配置
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30

# 安全配置
ENABLE_RATE_LIMITING=true
MAX_REQUESTS_PER_MINUTE=100
ENABLE_CORS=true
ALLOWED_ORIGINS=https://yourdomain.com

# 功能开关
ENABLE_ANALYTICS=true
ENABLE_MONITORING=true
ENABLE_BACKUP=true
ENABLE_SSL=true
